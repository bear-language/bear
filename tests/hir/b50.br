// tests/hir/b50.br

contract Into<T> {
    mt into() -> T;
}

struct IntoSomething<T> has Into<T> {
    T a; 
    mt into() -> T => self.a
}

IntoSomething::i32 _0 = {.a = 1};

struct IntoSomethingOops<T> has Into<T> {
    T a; 
    mt into() -> i32 => self.a if compt @same_type(T, i32) else 0
}

IntoSomethingOops::i32 _1 = {.a = 1}; // fine
IntoSomethingOops::i64 _2 = {.a = 1}; // oops (+ somewhat helpful diagnostic)
