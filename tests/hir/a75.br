// tests/hir/a75.br

import "compt_fn.br";

mod hir_a75; // @COOL

compt var iden = |var a| -> var => a;

var _0 = @static_assert iden(12) == 12;

struct Foo {
    i32 a = 0;
}

var _1 = @static_assert iden(Foo{}) == Foo{.a = 42}; // oops

compt var my_42 = 42;

compt var get_42 = || -> i32 => my_42;

var _2 = @static_assert get_42() as u16 == 42 as u8;

var _3 = @static_assert map([1, 2, 3, 4], |i32 a| -> i32 => a*2) == [2,4,6,8];

var _4 = @static_assert filter([1, 2, 3, 4], |i32 a| => a%2 == 0) == [2,4];

compt var even = |i32 x| => x % 2 == 0;

var _5 = @static_assert [2, 2, 2, 4, 6, 12].filter(even).all(even);

var _6 = @static_assert [6, 7, 67, 42, 23123, 2].some(even);

compt var some_primes = [1, 3, 5, 7, 11, 13, 17];

compt var odd = |i32 x| => !even(x);

var _7 = @static_assert some_primes.map(|i32 x| -> i32 => x * 2).all(even);

compt var triple = |i32 x| -> i32 => x * 3;

var _8 = @static_assert some_primes.map(triple).all(odd);

var _9 = @static_assert some_primes.map(triple).all(even); // oops

var _10 = @static_assert @same_type(typeof triple, *fn(i32)->i32);
