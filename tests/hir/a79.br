// tests/hir/a79.br

mod hir_a79;

/// wrap something in a tuple i number of times
compt fn duple<T>(T a, i32 i) -> var => a if (i <= 0) else (duple(a, i - 1),)

/// wrap something in a tuple 
compt fn tuple<T>(T a) -> var => (a,)

compt var a = duple(1, 3);

var _0 = @static_assert a == (((1,),),);

var _1 = @static_assert a.duple(3).duple(3) == (((1,),),).duple(3).duple(3);

var _2 = @static_assert a.duple(1) == a.tuple();

var _3 = @static_assert a.duple(1) == a.tuple().tuple(); // oops

