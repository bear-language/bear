// tests/hir/a95.br

// testing address of operator (^) and some borrowing

fn main() {
    fine();
    oops();
}

fn fine() {
    i32 a;
    var b = ^a;
    *var _c = b;
    *i32 d = b;
    *i32 e = ^a;
    &i32 _f = &e.*;
}

fn oops() {
    i32 a;
    i32 b = ^a; // oops
    **i32 c = ^^b; // oops
    *i32 d = c.*;
    *i32 _e = ^d.*;
    ***i32 f = ^c;
    &***i32 _g = f; // oops
    *i32 _h = a; // oops

    *i32 mut _i = ^mut a; // fine due to value semantics

    mut i32 aa;
    
    *i32 mut _j = ^aa;
    var mut _k = ^aa;

    *i32 _l = 5; // oops, but not an lvalue so addr of is not recommended
    
    &i32 _m = 5; // oops, borrow is recommended since compt values get promoted to static memory

    &mut i32 _o = 5; // oops, but compt values can't be mut borrowed so borrow is not recommended

    &mut i32 _n = a; // oops
    
}


