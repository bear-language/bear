// tests/hir/a58.br

struct Foo has Get<i32> {
    i32 a = 0;
    mt get() -> i32 => self.a
}

struct Bar has Get<Foo> {
    Foo a = {};
    mt get() -> Foo => self.a
}

contract Get<T> {
    mt get() -> T;
}

struct Getter<G> {
    fn invoke<T has Get<G>>(T gettable) -> G => gettable.get()
}

struct _Mew<T> {
    T a;
    T b;
}

struct Triple<A,B,C> {}

compt fn triple<A, B, C>(Triple<A,B,C> foo) -> Triple<A,B,C> => foo if !@err(!(@same_type(A, B) && @same_type(B, C)), "the passed in triple should have A, B, and C of the same type") else foo

compt var a = Bar{};

compt var b = Getter..invoke::<Foo, Bar>(a);

var _0 = @static_assert b.get() == 0;

var _1 = @static_assert @same_type(Foo, typeof b);

var _2 = @static_assert b.get() == 1; // oops

compt var bad_trip = Triple::<i32, u32, u64>{};

compt var good_trip = Triple::<u8,u8,u8>{};

var _3 = triple::<i32, u32, u64>(bad_trip);

var _4 = triple(bad_trip);

var _5 = triple(good_trip);
