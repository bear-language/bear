// tests/hir/a94.br

// testing pre/post ++ and --, pointer deref, and runtime pre-unary ops

struct Foo {
    i32 x = 0;
}

fn fine(mut i32 p, mut f64 f, mut char c) {
    mut i32 a = 0;
    a++;
    --a;
    mut i32 b = a++;
    mut i32 _d = --b;
    f++; // floats are fine
    --c;
    p--;
    mut Foo foo = Foo{};
    foo.x++;
    ++(++a); // pre ++ yields an lvalue
}

fn oops(i32 p) {
    i32 a = 0;
    a++; // oops, immutable
    --p; // oops, immutable
    mut bool t = true;
    t++; // oops, not numeric
    5++; // oops, temporary
    mut i32 m = 0;
    ++(m++); // oops, post ++ yields a temporary
}

fn deref(*i32 mut pm, *i32 p, *void pv, &i32 r) {
    i32 _a = pm.*;
    i32 _b = p.*;
    pm.*++; // chained postfix ops
    i32 _e = pm.*--;
    (pm.*)++;
    --pm.*;
    ++p.*; // oops, pointee is immutable
    p.*--; // oops, pointee is immutable
    var _ = pv.*; // oops, *void
    var _ = r.*; // oops, refs are auto-dereferenced
}

fn ptr_inc(*mut i32 pm, mut *fn(i32)->i32 fp, mut *void pv) {
    pm++;
    fp++; // oops, fn ptrs aren't viable
    pv++; // oops, *void has no element size
    --pv; // oops, *void has no element size
}

fn unary(i32 a, u32 u, f64 x, bool b) {
    i32 _n = -a;
    i32 _k = ~a;
    f64 _y = -(-x);
    bool _nb = !b;
    var _ = -u; // oops, unsigned vals can't be negated
    var _ = !a; // oops
    var _ = ~x; // oops
}
