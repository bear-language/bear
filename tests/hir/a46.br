// tests/hir/a46.br

struct Foo {
    i32 a = 1;
    i32 b = 12;
    i32 c = 123;

    static compt i32 d = 0;
    static compt i32 e = 0;
    static compt i32 f = 0;
}

compt Foo my_foo = {};

compt var a = @members_of(typeof my_foo);

var _0 = @static_assert a == ["a", "b", "c"];

var _1 = @static_assert a == ["uh", "rut", "roh"]; // oops

compt var b = @statics_of(typeof Foo{});

var _2 = @static_assert b == ["d", "e", "f"];

var _3 = @static_assert b == ["umm", "rut", "roh"]; // oops

compt var c = @members_of(Foo);

var _4 = @static_assert c != [];

compt var d = @members_of(i32);

var _5 = @static_assert d == []; // TODO doesn't work

compt var e = @statics_of(i32);
