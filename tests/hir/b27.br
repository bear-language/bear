// tests/hir/b27.br

// testing runtime if statements

fn main() {
    sign(0);
    clamp(1, 0, 2);
    scoped(1);
    picks();
    oops_cond(1, 1);
    oops_body(false);
    oops_scope(true);
    oops_return(true);
    oops_else_if_return(true, true);
}

fn sign(i32 a) -> i32 {
    if a > 0 {
        return 1;
    } else if a < 0 {
        return -1;
    } else {
        return 0;
    }
}

fn clamp(i32 a, i32 lo, i32 hi) -> i32 {
    mut i32 r = a;
    if a < lo {
        r = lo;
    }
    if a > hi {
        r = hi;
    }
    return r;
}

fn scoped(bool c) -> i32 {
    if c {
        i32 x = 1;
        return x;
    } else {
        i64 x = 2; // fine, separate scope
    }
    return 3;
}

fn picks() -> i32 {
    if compt 1 > 2 {
        return undeclared; // fine, never solved
    } else {
        return 4;
    }
}

fn oops_cond(u8 n, i32 a) {
    if n { // oops, not bool
        a + 1;
    }
    if compt a > 0 { // oops, not compt
        a + 1;
    }
    if n { // oops, not bool
        i32 _0 = true; // oops, still checked
    } else {
        i32 _1 = false; // oops, still checked
    }
    if compt a > 0 { // oops, not compt
        i32 _2 = true; // oops, still checked
    } else {
        i32 _3 = false; // oops, still checked
    }
}

fn oops_body(bool c) {
    if c {
        i32 _0 = c; // oops, bool -> i32
    } else if !c {
        missing(); // oops, undeclared
    }
}

fn oops_scope(bool c) -> i32 {
    if c {
        i32 x = 1;
    }
    return x; // oops, x is out of scope
}

fn oops_return(bool c) -> i32 {
    if c {
        return 1;
    } // oops, no else so may not return
}

fn oops_else_if_return(bool c, bool d) -> i32 {
    if c {
        return 1;
    } else if d {
        return 2;
    } // oops, may not return
}
