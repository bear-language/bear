// tests/hir/65.br

// these are fine since these literals can be given static addresses
&mut i32 foo = 15;
&mut i32 mut foo1 = 17;

contract Foo {
    fn foo(&mut Self self) -> &i32;
}

struct Fooer has Foo {
    mut i32 a;
    fn foo(&mut Self _self) -> &mut i32 { // oops, signature mismatch
        a++;
        return &mut a;
    }
    fn fooey(&mut Self _self) -> &i32 mut { // oops, malformed
        a++;
        return &a;
    }
    fn foogie(&mut Self mut _self) {} // oops
    fn foogiey(&Self mut _self) {} // oops 

    deftype Shelf = Self;
    deftype Elf = Self;
    deftype Belf = Elf;
    deftype Melf = Belf;

    fn fogie() -> & Melf mut {} // oops 

}
