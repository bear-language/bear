// tests/hir/b08.br

// testing `as` casts and compt conversions

struct Foo { 
    i32 x; 
}

struct Bar { 
    i32 x; 
}

deftype MyInt = i32;

fn main() {
    compt i32 a = 0;
    var _0 = a as bool;
    var _1 = a as u8;
    okay();
    oops();
    compt_oops();
    compt_okay();
    compt_bounds_oops();
}

fn okay() {
    i32 r = 5;
    var _0 = r as bool;
    var _1 = r as f64;
    var _2 = r as char;
    var _3 = r as i32; // same type
    var _4 = r as u8;
    var _5 = r as MyInt;
    var _6 = (r as u8) as i64;

    MyInt m = 3;
    var _7 = m as i64;

    f64 fl = 1.5;
    var _8 = fl as i32;

    bool b = true;
    var _9 = b as u8;

    char c = 'a';
    var _10 = c as u32;

    str s = "hi";
    var _11 = s as str;

    *i32 p = ^r;
    var _12 = p as *u8;
    var _13 = p as *i32;

    Foo f = Foo{.x = 1};
    var _14 = f as Foo;
}

fn oops() {
    i32 r = 5;
    var _0 = r as str; // oops
    var _1 = r as void; // oops
    var _2 = r as *i32; // oops
    var _3 = r as Ooops; // oops, DNE
    var _4 = undefined_var as i32; // oops

    *i32 p = ^r;
    var _5 = p as i32; // oops

    str s = "hi";
    var _6 = s as i32; // oops

    Foo f = Foo{.x = 1};
    var _7 = f as Bar; // oops
    var _8 = f as i32; // oops
    var _9 = r as Foo; // oops
}

fn compt_oops() {
    compt i32 a = 300;
    var _0 = a as u8; // oops, guaranteed narrowing
    var _1 = 256 as u8; // oops, guaranteed narrowing
    var _2 = -129 as i8; // oops, guaranteed narrowing
    var _3 = a as Foo; // oops, not convertible 
    var _4 = a as *i32; // oops, not convertible 
    var _5 = a as void; // oops
    var _6 = a as Oops; // oops
    var _7 = Foo{.x = 1} as i32; // oops
    var _8 = [1, 2] as i32; // oops
    var _9 = "x" as i32; // oops
    var _10 = 1.5 as u8; // oops

    var _11 = 2.75 as i32; // oops, not a whole number
    var _12 = true as i32; // fine
    compt i64 sixfour = 64;
    var _13 = 64 as char; // fine
    var _14 = sixfour as char; // fine
}

fn compt_okay() {
    // every integral type -> char
    compt i8 i8_64 = 64;
    compt u8 u8_64 = 64;
    compt i16 i16_64 = 64;
    compt u16 u16_64 = 64;
    compt i32 i32_64 = 64;
    compt u32 u32_64 = 64;
    compt i64 i64_64 = 64;
    compt u64 u64_64 = 64;
    var _0 = @static_assert((i8_64 as char) == '@');
    var _1 = @static_assert((u8_64 as char) == '@');
    var _2 = @static_assert((i16_64 as char) == '@');
    var _3 = @static_assert((u16_64 as char) == '@');
    var _4 = @static_assert((i32_64 as char) == '@');
    var _5 = @static_assert((u32_64 as char) == '@');
    var _6 = @static_assert((i64_64 as char) == '@');
    var _7 = @static_assert((u64_64 as char) == '@');

    // char range edges (chars are signed 8 bit)
    compt i32 i32_127 = 127;
    compt i64 i64_neg128 = -128;
    compt u64 u64_127 = 127;
    var _8 = @static_assert(((i32_127 as char) as i32) == 127);
    var _9 = @static_assert(((i64_neg128 as char) as i64) == -128);
    var _10 = @static_assert(((u64_127 as char) as u64) == 127);

    // char -> every integral type
    compt char at = '@';
    var _11 = @static_assert((at as i8) == 64);
    var _12 = @static_assert((at as u8) == 64);
    var _13 = @static_assert((at as i16) == 64);
    var _14 = @static_assert((at as u16) == 64);
    var _15 = @static_assert((at as i32) == 64);
    var _16 = @static_assert((at as u32) == 64);
    var _17 = @static_assert((at as i64) == 64);
    var _18 = @static_assert((at as u64) == 64);
    var _19 = @static_assert((at as f64) == 64.0);
    var _20 = @static_assert(at as bool);
    var _21 = @static_assert((at as str) == "@");

    // negative chars keep their sign, and wrap when explicitly cast to unsigned (like `-1 as u32`)
    compt char neg_c = (-5 as i8) as char;
    var _22 = @static_assert((neg_c as i8) == -5);
    var _23 = @static_assert((neg_c as i64) == -5);
    var _24 = @static_assert((neg_c as u8) == 251);
    var _25 = @static_assert((neg_c as u32) == 4294967291);

    // implicit char conversions are fine when the value fits
    compt u8 _26 = at;
    compt i32 _27 = at;

    // f32 -> everything
    compt f32 f32_3 = 3.0;
    var _28 = @static_assert((f32_3 as i8) == 3);
    var _29 = @static_assert((f32_3 as u8) == 3);
    var _30 = @static_assert((f32_3 as i16) == 3);
    var _31 = @static_assert((f32_3 as u16) == 3);
    var _32 = @static_assert((f32_3 as i32) == 3);
    var _33 = @static_assert((f32_3 as u32) == 3);
    var _34 = @static_assert((f32_3 as i64) == 3);
    var _35 = @static_assert((f32_3 as u64) == 3);
    var _36 = @static_assert((f32_3 as char) == ((3 as i8) as char));
    var _37 = @static_assert((f32_3 as f64) == 3.0);
    var _38 = @static_assert(f32_3 as bool);

    // f64 -> smaller integral types and char
    compt f64 f64_neg2 = -2.0;
    compt f64 f64_65 = 65.0;
    var _39 = @static_assert((f64_neg2 as i8) == -2);
    var _40 = @static_assert((f64_neg2 as i16) == -2);
    var _41 = @static_assert((f64_65 as u8) == 65);
    var _42 = @static_assert((f64_65 as u16) == 65);
    var _43 = @static_assert((f64_65 as char) == 'A');
    var _44 = @static_assert(((f64_65 as f32) as f64) == 65.0);

    // float range edges
    compt f64 u32_max = 4294967295.0;
    compt f64 two_63 = 9223372036854775808.0;
    var _45 = @static_assert((u32_max as u32) == 4294967295);
    var _46 = @static_assert((two_63 as u64) == 9223372036854775808);

    // bool -> everything (explicit only)
    compt bool t = true;
    compt bool f = false;
    var _47 = @static_assert((t as i8) == 1);
    var _48 = @static_assert((t as u8) == 1);
    var _49 = @static_assert((t as i16) == 1);
    var _50 = @static_assert((t as u16) == 1);
    var _51 = @static_assert((t as i32) == 1);
    var _52 = @static_assert((t as u32) == 1);
    var _53 = @static_assert((t as i64) == 1);
    var _54 = @static_assert((t as u64) == 1);
    var _55 = @static_assert((f as i32) == 0);
    var _56 = @static_assert((t as f32) == (1.0 as f32));
    var _57 = @static_assert((t as f64) == 1.0);
    var _58 = @static_assert((t as char) == ((1 as i8) as char));
    var _59 = @static_assert(t as bool);
    var _60 = @static_assert((t as str) == "true");
    var _61 = @static_assert((f as str) == "false");
}

fn compt_bounds_oops() {
    // out of char range
    compt i32 i32_128 = 128;
    compt i64 i64_neg129 = -129;
    compt u8 u8_200 = 200;
    compt u64 u64_max = 18446744073709551615;
    compt i64 i64_max = 9223372036854775807;
    var _0 = i32_128 as char; // oops, guaranteed narrowing
    var _1 = i64_neg129 as char; // oops, guaranteed narrowing
    var _2 = @static_assert(((u8_200 as char) as i8) == -56); // fine, same bit width wraps like `u8 as i8`
    var _3 = u64_max as char; // oops, guaranteed narrowing
    var _4 = i64_max as char; // oops, guaranteed narrowing

    // floats must be whole and in range, and never wrap
    compt f64 f64_half = 65.5;
    compt f64 f64_300 = 300.0;
    compt f64 f64_neg1 = -1.0;
    compt f32 f32_half = 2.5;
    var _5 = f64_half as char; // oops, not a whole number
    var _6 = f64_300 as u8; // oops
    var _7 = f64_300 as char; // oops
    var _8 = f64_neg1 as u8; // oops
    var _9 = f64_neg1 as u64; // oops
    var _10 = f32_half as i32; // oops, not a whole number

    // 64 bit float edges
    compt f64 two_63 = 9223372036854775808.0;
    compt f64 two_64 = 18446744073709551616.0;
    compt f64 huge = 1e300;
    var _11 = two_63 as i64; // oops, one past i64 max
    var _12 = two_64 as u64; // oops, one past u64 max
    var _13 = huge as f32; // oops, too big for f32

    // implicit conversions stay strict
    compt char neg_c = (-5 as i8) as char;
    compt bool t = true;
    compt u8 _14 = neg_c; // oops, negative char to unsigned
    compt u32 _15 = neg_c; // oops, negative char to unsigned
    compt i32 _16 = t; // oops, bool -> integral is explicit only
    compt char _20 = u8_200; // oops, 200 doesn't fit in a char
    var _17 = t + 1; // oops
    var _18 = t as void; // oops
    var _19 = t as Foo; // oops
}
