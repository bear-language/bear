// tests/hir/b40.br

fn main() {
    var _ = compt_for();
    var _ = for_in();
}

struct Foo has Iterator<i32> {
    i32 a = 0;
    i32 b = 0;
    i64 c = 0;
    i64 d = 0;

    static i32 e = 42;
    static i32 f = 67;

    /// bumps a until it equals e + f or is greater
    mt mut next() -> Opt<i32> {
        if self.a >= e + f {
            return Opt..None::<i32>;
        }
        return Opt..Some::<i32>(++self.a);
    }
}

struct Bar {
    Foo foo = {};
    mt iter() -> Foo => self.foo
}

fn compt_for() -> i32 {
    mut i32 v;
    for compt var x in @members_of(Foo) {
        var _ = @note(x); // note, compt str for member name
        v += 1;
    }
    for compt var x in @statics_of(Foo) {
        var _ = @note(x); // note, compt str for static name
        v += 2;
    }
    for compt var x in 0...(@members_of(Foo).len) {
        var _ = @note(x as str); // note, compt member index
        v += 3;
    }
    for compt var x in 0...(@members_of(Foo).len) {
        var _ = @note(x as str); // note, compt member index
        v += 4;
    }
    for compt var s in ["1", "2", "3"] {
        var _ = @note(s); // note
    }
    for compt var i in [1, 34, 56, 78, 9] {
        var _ = @note(i as str); // note
    }
    for compt var c in "ab" {
        var _ = @note(c as str); // note
    }
    for compt var x in 0...512 { // fine, exactly at the cap
        v += 5;
    }
    for compt var x in 0...=512 { // oops, exceeds the cap
        v += 6;
    }
    compt [&]str strs = ["a", "b", "c", "d"];
    for compt var x in strs {
        v += 6;
    }
    return v;
}

fn for_in() {
    i32 mut v;
    for i32 x in (Foo{}) {
        v++;
    }
    for mut i32 x in (Foo{}) {
        v++;
    }
    for &i32 x in (Foo{}) {
        v++;
    }
    for var x in (Foo{}) {
        v++;
    }
    for &var x in (Foo{}) {
        v++;
    }
    for u32 x in (Foo{}) { // oops
        v++;
    }
    for i32 x in (Bar{}).iter() {
        v++;
    }
    Bar bar = {};
    for var x in bar.iter() {
        v++;
    }
    for char c in "abc" {
        v++;
    }
    str s = "abc";
    for &char c in s {
        v++;
    }
    for var x in bar { // oops
        v++;
    }

    [4]i32 arr = [1,2,3,4];
    for i32 x in arr {
        v++;
    }
    for &i32 x in arr {
        v++;
    }
    i32 s = 0;
    i32 e = 12;
    for i32 x in s...e {
        x++; // oops
    }
    for i32 x in 1234 { // oops
        x++; // oops
    }
    i32 c = 0;
    for var x in 1234 { // oops
        v++;
        c++; // oops
    }
    for mut var x in bar { // oops
        x++;
        c++; // oops
    }
    for &var x in 1234 { // oops
        v += x;
        c++; // oops
    }
    for var x in 1.0...2.0 { // oops
        v++;
        c++; // oops
    }
    var a; // oops
    for &mut i32 x in 1234 { // oops
        x++;
        c++; // oops
        a++;
    }
}

var a; // oops
