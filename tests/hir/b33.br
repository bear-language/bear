// tests/hir/b33.br

// testing warns on always true/false ==/!=

fn main() {
    oops(1);
    warn(1);
    var _0 = Foo..A();
    var _1 = Foo..D(1);
    var _2 = nan(1.0);
    lit(1);
}

fn oops(i32 mut a) {
    while a == a { // warn
        1+1; // oops unused
    }
    while (12 == 12) { // oops (unreachable since above loop never terminates):
        a++;
    }
    while a != a { // warn
        ++a;
    }
}

u32 mut g;

fn foo() -> u32 => g++

fn warn(u32 mut a) {
    while a != a { // warn
        ++a;
    }

    while Foo..A == Foo..B { // warn
        ++a;
    }

    while Foo..A != Foo..A { // warn
        a += 4;
    }

    while compt(Foo..D(12) != Foo..D(12)) { // warn
        a += 42;
    }

    while compt(Foo..D(12) == Foo..D(14)) { // warn
        a += 42;
    }

    while (Foo..D(a) != Foo..D(a)) { // warn
        a += 42;
    }

    while (Foo..D(a++) != Foo..D(a)) { // fine
        a += 42;
    }

    if (Foo..D(a) != Foo..D(a)) { // warn
        a++;
    }

    if (a == a) { // warn
        a++; 
    }

    if (a != a) { // warn
        a++;
    }

    if (a + foo() == a + foo()) { // fine
        var _ = foo();
    }

    a++ if a == a else a += 32; // warn

    a++ if true else a += 32; // warn

    a++ if compt true else a += 32; // fine

    asdasASHJDFaskjhdfgaksjdf if compt false else a++; // fine cuz conditional compilation (if compt)
}

variant Foo {
    A,
    B,
    C,
    D(u32 a),
}

fn nan(f64 x) -> bool => x != x // fine (NaN check)

fn lit(mut u32 a) {
    if true { // warn
        a++;
    }

    if false { // warn
        a++;
    }

    while a != a { // warn
        1+1; // unused warn is separate from the loop warn
    }

    for (mut var i = 0; a != a; i++) { // warn (always false, not "never terminates")
        a++;
    }

    1+1 if a == a else 2+2; // warn (no `if compt` fix since `a == a` isn't compt)
}
