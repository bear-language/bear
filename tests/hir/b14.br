// tests/hir/b14.br

// testing runtime subscripting of slices, arrays, ptrs, and strs

deftype usize = u64;

struct Foo {
    i32 a;
}

fn fine([&]i32 s, [&mut]i32 ms, [4]i32 a, [4]mut i32 ma, *i32 p, *i32 mut mp, *Foo pf, str st, usize i) {
    i32 _0 = s[i];
    i32 _1 = a[0];
    i32 _2 = p[i + 1];
    char _3 = st[i];
    i32 _4 = pf[0].a;
    ms[i] = 1;
    ma[3] = 2;
    mp[0] += 3;
    ms[0]++;
    var _5 = ^mut ma[1];
    (mp + 1)[0] = 4; // ptr elems are lvalues even thru a temporary ptr
    var _6 = ^mut (mp + i)[1];
    (mp + 2)[0]++;
}

fn oops([&]i32 s, [4]i32 a, *i32 p, *void pv, i32 x, i32 si, str st) {
    s[0] = 1; // oops, immut slice
    a[0] = 1; // oops, immut array
    p[0] = 1; // oops, immut ptr
    st[0] = 'a'; // oops, str chars aren't mutable
    var _0 = pv[0]; // oops, *void can't be indexed
    var _1 = x[0]; // oops, i32 isn't indexable
    var _2 = s[si]; // oops, idx needs a cast to usize
    var _3 = s[-1]; // oops, idx must be unsigned
    var _4 = s[1.5]; // oops, idx must be an integer
    (p + 1)[0] = 1; // oops, still an immut ptr
}

fn arr_bounds([4]i32 a, [2][3]i32 aa, usize i) {
    i32 _0 = a[3]; // fine, last elem
    i32 _1 = aa[1][2]; // fine
    i32 _2 = a[i + 10]; // fine, runtime idx isn't statically checked
    i32 _3 = a[4]; // oops, out of bounds
    i32 _4 = aa[1][3]; // oops, out of bounds on the inner array
    i32 _5 = aa[2][0]; // oops, out of bounds on the outer array
}

fn oops_rebindable(*mut i32 rp, i32 x) {
    rp = ^x; // fine, rp is rebindable
    rp[0] = 1; // oops, rebindable ptr to immut i32
    rp.* = 1; // oops, same thru an explicit deref
}

struct Foo2 {
    i32 a;
}

fn oops_rebindable_arrow(*mut Foo2 rpf) {
    rpf->a = 1; // oops, rebindable ptr to immut Foo2
}
