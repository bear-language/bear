// tests/hir/b22.br

// testing that references to locals and by-value params cannot be returned

struct Pair {
    i32 a;
    i32 b;
}

fn fine_param(&i32 r) -> &i32 => &r;
fn fine_param_member(&Pair p) -> &i32 => &p.a;
fn fine_reborrow(&i32 r) -> &i32 {
    &i32 local_ref = &r;
    return &local_ref;
}
fn fine_slice([&]i32 s) -> &i32 {
    [&]i32 t = s;
    return &t[0];
}

fn oops_local() -> &i32 {
    i32 x = 1;
    return &x; // oops
}
fn oops_member() -> &i32 {
    Pair p = Pair{.a = 1, .b = 2};
    return &p.b; // oops
}
fn oops_array() -> &i32 {
    [2]i32 arr = [1, 2];
    return &arr[1]; // oops
}
fn oops_mut() -> &mut i32 {
    mut i32 x = 1;
    return &mut x; // oops
}
fn oops_param(i32 v) -> &i32 => &v; // oops
fn oops_param_member(Pair p) -> &i32 {
    return &p.a; // oops
}
fn fine_mut_ref_param(&mut Pair p) -> &mut i32 => &mut p.b;
