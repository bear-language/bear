fn main([&]str args) -> i32 {
    oopsie
    typeof(thing);
    deftype Thing = Foo;
    Thing a; 
    deftype ThingAgain = typeof(a);
}

struct Foo {
    Rc::Vec<Foo> tally;
    fn default() {
        Rc::Vec<Foo> tally = Rc..from(Vec..new());
        return Self{.tally = tally};
    }
    mt mut destruct() {
        tally.remove(self);
    }
}
