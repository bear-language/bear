// lib/ansi_codes.br

compt var ESC = "\033";
compt var ANSI_RESET = ESC + "[0m";
// text styles
compt var ANSI_BOLD = ESC + "[1m";
compt var ANSI_FAINT = ESC + "[2m";
compt var ANSI_ITALIC = ESC + "[3m";
compt var ANSI_UNDERLINE = ESC + "[4m";
// foreground colors 
compt var ANSI_BLACK_FG = ESC + "[30m";
compt var ANSI_RED_FG = ESC + "[31m";
compt var ANSI_GREEN_FG = ESC + "[32m";
compt var ANSI_YELLOW_FG = ESC + "[33m";
compt var ANSI_BLUE_FG = ESC + "[34m";
compt var ANSI_MAGENTA_FG = ESC + "[35m";
compt var ANSI_CYAN_FG = ESC + "[36m";
compt var ANSI_WHITE_FG = ESC + "[37m";
// background colors
compt var ANSI_BLACK_BG = ESC + "[40m";
compt var ANSI_RED_BG = ESC + "[41m";
compt var ANSI_GREEN_BG = ESC + "[42m";
compt var ANSI_YELLOW_BG = ESC + "[43m";
compt var ANSI_BLUE_BG = ESC + "[44m";
compt var ANSI_MAGENTA_BG = ESC + "[45m";
compt var ANSI_CYAN_BG = ESC + "[46m";
compt var ANSI_WHITE_BG = ESC + "[47m";

